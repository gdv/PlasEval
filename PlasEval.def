Bootstrap: docker
From: python:3.13-slim

%files
    # Repo state relative to the directory you build from.
    # Do not use /tmp here: it is masked during %post.
    . /opt/PlasEval

%post
    set -eux
    pip install --no-cache-dir /opt/PlasEval
    rm -rf /opt/PlasEval

%environment
    export LC_ALL=C
    export PYTHONUNBUFFERED=1

%runscript
    exec plaseval "$@"

%test
    plaseval --help

%labels
    Description PlasEval - evaluation and comparison of plasmid binning
    Source https://github.com/gdv/PlasEval

%help
    apptainer run plaseval.sif eval --help