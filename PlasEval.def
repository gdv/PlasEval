Bootstrap: docker
From: python:3.13-slim

%files
    # Repo state relative to the directory you build from
    . /tmp/PlasEval

%post
    set -eux
    pip install --no-cache-dir /tmp/PlasEval
    rm -rf /tmp/PlasEval

%environment
    export LC_ALL=C
    export PYTHONUNBUFFERED=1

%runscript
    exec plaseval "$@"

%test
    plaseval --help

%labels
    Description PlasEval - evaluation and comparison of plasmid binning
    Source https://github.com/gdv/PlasEval

%help
    apptainer run plaseval.sif eval --help